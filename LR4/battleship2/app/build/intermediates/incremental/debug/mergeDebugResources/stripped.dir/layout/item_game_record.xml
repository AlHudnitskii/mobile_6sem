<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_result"
            android:layout_width="50dp" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:gravity="center"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView android:id="@+id/tv_opponent"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="@color/on_background"/>
            <TextView android:id="@+id/tv_date"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/on_surface_variant"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
