<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="12dp">

    <!-- Header card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Place Your Ships" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/on_background" android:gravity="center"/>
            <TextView android:id="@+id/tv_ships_remaining"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/primary" android:textSize="13sp"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Board fills available space -->
    <com.example.battleship.game.BoardView
        android:id="@+id/board_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp"/>

    <!-- Controls card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">

            <!-- Row 1: Rotate + Undo -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rotate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="↔ Horizontal"
                    android:textAllCaps="false" android:layout_marginEnd="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_undo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="↩ Undo"
                    android:textAllCaps="false" android:enabled="false"/>
            </LinearLayout>

            <!-- Row 2: Auto + Ready -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_auto_place"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="🎲 Auto Place"
                    android:textAllCaps="false" android:layout_marginEnd="6dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ready"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="✓ Ready!"
                    android:textAllCaps="false" android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

</LinearLayout>
