<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.timer.ui.main.MainFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_main">

        <action
            android:id="@+id/action_mainFragment_to_timerFragment"
            app:destination="@id/timerFragment" />
        <action
            android:id="@+id/action_mainFragment_to_editFragment"
            app:destination="@id/editFragment" />
        <action
            android:id="@+id/action_mainFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/timerFragment"
        android:name="com.example.timer.ui.timer.TimerFragment"
        android:label="Таймер"
        tools:layout="@layout/fragment_timer">
        <argument
            android:name="sequenceId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/editFragment"
        android:name="com.example.timer.ui.edit.EditFragment"
        android:label="Редактор"
        tools:layout="@layout/fragment_edit">
        <argument
            android:name="sequenceId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.timer.ui.settings.SettingsFragment"
        android:label="Настройки" />
</navigation>